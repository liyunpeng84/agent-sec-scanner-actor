{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "/home/dev/projects/demo"]
    },
    "time": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "TZ", "mcp/time@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"],
      "env": { "TZ": "Asia/Shanghai", "TIME_API_TOKEN": "${env:TIME_API_TOKEN}" }
    },
    "docs": {
      "url": "https://mcp.example.com/mcp",
      "headers": { "Authorization": "Bearer ${env:DOCS_TOKEN}" }
    }
  }
}
